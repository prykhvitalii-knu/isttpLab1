@model IEnumerable<MediaServerApp.Models.Data.WatchHistory>

@{
    ViewData["Title"] = "Watching History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-white">Continue Watching</h2>
        <span class="text-muted small">Showing last 20 movies</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-dark border-secondary text-center p-5 card movie-card">
            <h4 class="text-muted mb-0">Your history is empty</h4>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card movie-card text-white h-100 position-relative">
                        
                        <form asp-action="DeleteFromHistory" method="post" class="position-absolute top-0 end-0 p-2" style="z-index: 10;">
                            <input type="hidden" name="movieId" value="@item.MovieId" />
                            <button type="submit" class="btn btn-sm btn-danger bg-opacity-75 rounded-circle shadow" title="Remove from history">
                                ❌
                            </button>
                        </form>

                        <div class="movie-poster-placeholder">
                            🎬
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-truncate">@item.Movie.Title</h5>
                            <p class="card-text small text-muted">
                                Watched: @item.LastWatched?.ToString("HH:mm dd.MM")
                            </p>
                            <div class="d-grid mt-2">
                                <a asp-action="Details" asp-route-id="@item.MovieId" class="btn btn-outline-light btn-sm">
                                    Watch Again
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>