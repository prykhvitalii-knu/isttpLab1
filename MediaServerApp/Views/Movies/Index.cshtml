@model IEnumerable<MediaServerApp.Models.Data.Movie>

@{
    ViewData["Title"] = "Library";
    var savedIds = ViewBag.SavedMovieIds as List<int> ?? new List<int>();
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="fw-bold">@(ViewBag.PageTitle ?? "My Library")</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">+ Add Movie</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card movie-card text-white">
                    <form asp-action="ToggleSave" method="post" class="position-absolute top-0 end-0 p-2">
                        <input type="hidden" name="movieId" value="@item.Id" />
                        <button type="submit" class="btn btn-sm @(savedIds.Contains(item.Id) ? "btn-warning" : "btn-dark")">
                            ⭐
                        </button>
                    </form>
                    <div class="movie-poster-placeholder">
                        🎬
                    </div>
                    <div class="card-body">
                        <h5 class="card-title text-truncate">@item.Title</h5>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">@item.ReleaseDate?.Year</small>
                            <span class="badge badge-genre">@item.Duration min</span>
                        </div>
                        <div class="mt-3 d-grid">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-light btn-sm">Watch Now</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>