<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - _</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Movies" asp-action="Index">
                    <span style="color: #3d5afe;">VITA</span>STREAM
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Index">Library</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Genres" asp-action="Index">Genres</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <form class="d-flex ms-3" asp-controller="Movies" asp-action="Index" method="get">
                            <div class="input-group">
                                <input type="text" name="searchString" class="form-control bg-dark text-white border-secondary" 
                                    placeholder="Search movies..." value="@ViewBag.CurrentSearch">
                                <button class="btn btn-outline-secondary" type="submit">🔍</button>
                            </div>
                        </form>

                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="genreDropdown" role="button" data-bs-toggle="dropdown">
                                    Genres
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" asp-action="Index" asp-route-genreId="">All Genres</a></li>
                                    @if (ViewBag.Genres != null)
                                    {
                                        foreach (var genre in ViewBag.Genres)
                                        {
                                            <li><a class="dropdown-item" asp-action="Index" asp-route-genreId="@genre.Id">@genre.Name</a></li>
                                        }
                                    }
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-info" asp-action="Saved">⭐ Saved</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Movies" asp-action="History">History</a>
                            </li>
                        </ul>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Welcome, Vitalii</span>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - _ - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
